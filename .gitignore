# WIMS: only the program goes to GitHub. Everything else on this machine (the .env with passwords, uploads, backups, Excel workbooks with real
# subcontractor data, vendor, node_modules, logs, data exports) stays OUT. Start from "nothing", then let the code folders in.
/*
!/.gitignore
!/.cpanel.yml
!/.htaccess
!/app
!/artisan
!/bootstrap
!/composer.json
!/composer.lock
!/config
!/database
!/docs
!/lang
!/package.json
!/package-lock.json
!/packages
!/phpunit.xml
!/postcss.config.js
!/public
!/resources
!/routes
!/scripts
!/server.php
!/tailwind.config.js
!/tests
!/vite.config.js

# inside the allowed folders: still never
.env
.env.*
*.log
*.sql
*.sql.gz
*.xlsx
*.xls
*.bak
.DS_Store
.phpunit.result.cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/database/data/
/database/*.sqlite
/public/hot
/public/storage
/public/uploads
/public/wimshow-assets
/public/face-models
/public/audio
/public/logos
/public/images/profile-photos
/public/_*
/docs/subcontracts-workbook-analysis.md
/docs/subcontracts-data-review.md
/scripts/wimshow
/resources/knowledge/_*

# Holiday Greetings: the pictures made from the photos (black and white at 15%) are generated on the server when needed
/public/images/holiday/bg/*
!/public/images/holiday/bg/.gitkeep
